<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="TOP_RIGHT" prefHeight="344.0" prefWidth="608.0" spacing="20.0" xmlns="http://javafx.com/javafx/17.0.2-ea" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.diakok20260904.DiakokController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
   <HBox prefHeight="260.0" prefWidth="568.0">
      <children>
         <VBox alignment="TOP_CENTER" prefHeight="200.0" prefWidth="100.0">
            <children>
               <ImageView fitHeight="96.0" fitWidth="96.0" pickOnBounds="true" preserveRatio="true">
                  <VBox.margin>
                     <Insets bottom="10.0" />
                  </VBox.margin>
                  <image>
                     <Image url="@diak.png" />
                  </image>
               </ImageView>
               <Button id="btn_mindenki" fx:id="btn_mindenki" minWidth="76.0" mnemonicParsing="false" onAction="#onMindenkiButtonClick" text="Mindenki">
                  <VBox.margin>
                     <Insets bottom="10.0" />
                  </VBox.margin>
               </Button>
               <Button id="btn_sandorok" fx:id="btn_sandorok" minWidth="76.0" mnemonicParsing="false" onAction="#onSandorokButtonClick" text="Sándorok">
                  <VBox.margin>
                     <Insets bottom="10.0" />
                  </VBox.margin>
               </Button>
               <Button id="btn_kecskemeti" fx:id="btn_kecskemeti" minWidth="76.0" mnemonicParsing="false" onAction="#onKecskemetiButtonClick" text="Kecskeméti">
                  <VBox.margin>
                     <Insets bottom="10.0" />
                  </VBox.margin>
               </Button>
               <Button id="btn_1996" fx:id="btn_1996" minWidth="76.0" mnemonicParsing="false" onAction="#on1996ButtonClick" text="1996">
                  <VBox.margin>
                     <Insets bottom="10.0" />
                  </VBox.margin>
               </Button>
               <Button id="btn_10a" fx:id="btn_10a" minWidth="76.0" mnemonicParsing="false" onAction="#on10aButtonClick" text="10/A">
                  <VBox.margin>
                     <Insets bottom="10.0" />
                  </VBox.margin>
               </Button>
            </children>
            <HBox.margin>
               <Insets right="10.0" />
            </HBox.margin>
         </VBox>
         <ListView id="listview" fx:id="listview" prefHeight="423.0" prefWidth="461.0">
            <HBox.margin>
               <Insets />
            </HBox.margin>
         </ListView>
      </children>
   </HBox>
    <Button onAction="#onHelloButtonClick" text="Lista mentése" />
</VBox>
